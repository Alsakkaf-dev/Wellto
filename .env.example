# Postgres connection string (Neon works on Vercel). Required in production.
# The app creates the mahfaza_state table on first use.
DATABASE_URL=

# Signs the login cookie. Required on Vercel. Any long random string.
AUTH_SECRET=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Required on Vercel.
CRON_SECRET=

# Optional. If set to 4–6 digits, this PIN is accepted (handy if you lock yourself out).
APP_PIN=
